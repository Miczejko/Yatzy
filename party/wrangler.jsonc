{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yatzy-party",
  "main": "index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "YatzyRoom", "class_name": "YatzyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["YatzyRoom"] }],
  "routes": [{ "pattern": "yatzyserver.noteez.online", "custom_domain": true }]
}
